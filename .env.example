# Copy to .env and adjust as needed. Never commit the real .env file.

# --- Postgres (used by docker-compose.yml) ---
POSTGRES_USER=schoolhub
POSTGRES_PASSWORD=schoolhub
POSTGRES_DB=schoolhub
# Host port Postgres binds to. Change this if port 5432 is already in use
# on your machine (e.g. a local Postgres install) — container-to-container
# traffic (backend/migrate -> postgres) is unaffected either way.
POSTGRES_PORT=5432
# M20: password for the least-privilege schoolhub_app role the backend
# connects as (SELECT/INSERT/UPDATE/DELETE only — no DDL). Change this to
# something real before running backend/scripts/create_app_role.sql; see
# README's M20 section. migrate/sqlc keep using POSTGRES_PASSWORD above,
# since they need the schema-owning role.
SCHOOLHUB_APP_PASSWORD=schoolhub_app_dev

# --- Backend (backend/.env for local `go run`, or injected by the platform in deployment) ---
PORT=8080
APP_ENV=development
DATABASE_URL=postgres://schoolhub:schoolhub@localhost:5432/schoolhub?sslmode=disable
# Must be an exact origin (scheme+host+port) — the CORS middleware echoes
# this back for credentialed (cookie-bearing) cross-origin requests, and
# browsers refuse a wildcard "*" origin when credentials are involved.
FRONTEND_URL=http://localhost:3000
# Leave empty for a host-only session cookie (correct for local dev and for
# a production deployment where frontend/backend share a registrable
# domain). See README's "Deploying the demo (M35)" section for the
# split-domain note.
COOKIE_DOMAIN=
# Session cookie SameSite attribute: lax (default), strict, or none.
# "none" is REQUIRED when the frontend and API sit on different registrable
# domains (e.g. *.workers.dev frontend + *.onrender.com API) — a Lax cookie
# set in a cross-site response is dropped by the browser. Only allowed with
# APP_ENV=production (browsers reject SameSite=None without Secure).
COOKIE_SAMESITE=lax

# --- Clerk authentication bridge (all optional) ---
# Set BOTH for Clerk sign-in to engage; leave both empty to use the classic
# email/password session flow (the default local experience).
# Get these from https://dashboard.clerk.com -> your app -> API keys.
CLERK_SECRET_KEY=
# Frontend (frontend/.env.local):
#   NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
#
# When enabled:
#  - POST /api/v1/auth/clerk-session is mounted: it accepts a Clerk session
#    JWT, verifies it server-side, matches the verified email to a
#    provisioned account, and issues our standard session cookie.
#  - /login renders Clerk's hosted SignIn and /register its SignUp.
# No accounts are auto-created: admins provision accounts in the portals.

# --- Outbound email via Resend (all optional) ---
# Get an API key at https://resend.com (API Keys). Requires a verified
# domain for a custom sender address; the default uses Resend's onboarding
# sender which only delivers to your own account's email.
RESEND_API_KEY=
# Verified sender, e.g. "SchoolHub Academy <no-reply@notify.yourdomain.com>"
EMAIL_FROM_ADDRESS=SchoolHub Academy <onboarding@resend.dev>
#
# When enabled:
#  - Creating a staff login account emails a welcome message (best-effort).
#  - Publishing a school-wide announcement notifies ADMIN/TEACHER/STAFF
#    account holders by email (best-effort).

# --- Frontend (frontend/.env.local) ---
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
