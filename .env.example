# Copy to .env and adjust as needed. Never commit the real .env file.

# --- Postgres (used by docker-compose.yml) ---
POSTGRES_USER=schoolhub
POSTGRES_PASSWORD=schoolhub
POSTGRES_DB=schoolhub
# Host port Postgres binds to. Change this if port 5432 is already in use
# on your machine (e.g. a local Postgres install) — container-to-container
# traffic (backend/migrate -> postgres) is unaffected either way.
POSTGRES_PORT=5432

# --- Backend (backend/.env for local `go run`, or injected by the platform in deployment) ---
PORT=8080
APP_ENV=development
DATABASE_URL=postgres://schoolhub:schoolhub@localhost:5432/schoolhub?sslmode=disable
# Must be an exact origin (scheme+host+port) — the CORS middleware echoes
# this back for credentialed (cookie-bearing) cross-origin requests, and
# browsers refuse a wildcard "*" origin when credentials are involved.
FRONTEND_URL=http://localhost:3000
# Leave empty for a host-only session cookie (correct for local dev and for
# a production deployment where frontend/backend share a registrable
# domain). See README's "Authentication (M4)" section for the split-domain
# caveat.
COOKIE_DOMAIN=

# --- Frontend (frontend/.env.local) ---
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
