# Frontend environment. Copy to .env.local for local development.

# Go API base URL.
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1

# --- Clerk (optional) ---
# Set to enable Clerk sign-in (/login renders <SignIn/>, /register
# <SignUp/>) and the backend's POST /auth/clerk-session bridge (the backend
# needs CLERK_SECRET_KEY set too). Leave empty to use the classic
# email/password session flow.
# Get from https://dashboard.clerk.com -> your app -> API keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
